---
interface Props {
  command: string;
  label: string;
  done: string;
  failed: string;
}
const { command, label, done, failed } = Astro.props;
---
<div class="copy" data-copy-box>
  <code class="copy__code"><span class="copy__prompt" aria-hidden="true">$ </span><span data-copy-text>{command}</span></code>
  <button class="copy__button" type="button" data-copy data-done={done} data-failed={failed}>{label}</button>
  <span class="copy__status" role="status" data-copy-status></span>
</div>

<script>
  import { copyText } from '../lib/clipboard';

  for (const box of document.querySelectorAll<HTMLElement>('[data-copy-box]')) {
    const button = box.querySelector<HTMLButtonElement>('[data-copy]')!;
    const text = box.querySelector<HTMLElement>('[data-copy-text]')!;
    const status = box.querySelector<HTMLElement>('[data-copy-status]')!;
    const original = button.textContent ?? '';
    let reset: number | undefined;

    button.addEventListener('click', async () => {
      const copied = await copyText(text.textContent ?? '');
      if (copied) {
        button.textContent = button.dataset.done ?? original;
        status.textContent = button.dataset.done ?? '';
      } else {
        // No clipboard access: select the command so ⌘C works.
        const range = document.createRange();
        range.selectNodeContents(text);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        status.textContent = button.dataset.failed ?? '';
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        button.textContent = original;
        status.textContent = '';
      }, copied ? 2000 : 5000);
    });
  }
</script>

<style>
  .copy {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-raised);
  }

  .copy__code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.875rem;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, black 88%, transparent);
  }

  .copy__code::-webkit-scrollbar {
    display: none;
  }

  .copy__prompt {
    color: var(--text-muted);
  }

  .copy__button {
    flex: none;
    min-height: 36px;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 650;
    cursor: pointer;
  }

  .copy__button:hover {
    background: var(--bg-sunken);
  }

  .copy__status {
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
