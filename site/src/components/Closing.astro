---
import CopyCommand from './CopyCommand.astro';
import DownloadButton from './DownloadButton.astro';
import type { Strings } from '../i18n/types';
import { INSTALL_COMMAND } from '../lib/constants';
import { withBase } from '../lib/paths';

interface Props {
  s: Strings;
}
const { s } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="section closing">
  <div class="container closing__inner">
    <img class="closing__icon" src={withBase(base, 'icon-256.png')} width="128" height="128" alt="" loading="lazy" data-reveal />
    <h2 class="closing__title" data-reveal style="--delay: 80ms">{s.closing.title}</h2>
    <p class="lead closing__text" data-reveal style="--delay: 140ms">{s.closing.text}</p>
    <div class="closing__actions" data-reveal style="--delay: 200ms">
      <DownloadButton label={s.hero.download} versionTemplate={s.hero.downloadVersion} size="lg" />
      <CopyCommand command={INSTALL_COMMAND} label={s.copy.label} done={s.copy.done} failed={s.copy.failed} />
    </div>
  </div>
</section>

<style>
  .closing__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .closing__icon {
    width: 128px;
    height: 128px;
  }

  .closing__title {
    margin-top: 1.75rem;
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .closing__text {
    margin-inline: auto;
  }

  .closing__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    width: min(100%, 30rem);
    margin-top: 2rem;
    padding-bottom: 1.5rem;
  }

  .closing__actions > :global(.copy) {
    width: 100%;
  }
</style>
